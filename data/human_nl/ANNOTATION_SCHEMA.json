      [
        "FORWARD",
        2
      ]
    ]
  },
  "files": {
    "auto": "data/human_nl/sail_auto_annotated.jsonl",
    "review": "data/human_nl/sail_needs_review.jsonl",
    "import_format": "JSONL with text, slots [[OP,n],...], status"
  }
}